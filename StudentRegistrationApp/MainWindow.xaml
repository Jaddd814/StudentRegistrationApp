<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration App"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- JUDUL APLIKASI -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="STUDENT REGISTRATION APP"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Aplikasi sederhana untuk mengelola data mahasiswa"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FORM INPUT -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="FORM MAHASISWA"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="NIM"/>

                    <TextBox x:Name="txtNim"
                             Height="30"
                             Margin="0,5,0,10"/>

                    <TextBlock Text="Nama Mahasiswa"/>

                    <TextBox x:Name="txtNama"
                             Height="30"
                             Margin="0,5,0,10"/>

                    <TextBlock Text="Program Studi"/>

                    <ComboBox x:Name="cmbProdi"
                              Height="30"
                              Margin="0,5,0,10">

                        <ComboBoxItem Content="Teknik Informatika"/>
                        <ComboBoxItem Content="Sistem Informasi"/>
                        <ComboBoxItem Content="Manajemen"/>
                        <ComboBoxItem Content="Akuntansi"/>

                    </ComboBox>

                    <TextBlock Text="Jenis Kelamin"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,10">

                        <RadioButton x:Name="rbLaki"
                                     Content="Laki-laki"
                                     Margin="0,0,20,0"/>

                        <RadioButton x:Name="rbPerempuan"
                                     Content="Perempuan"/>

                    </StackPanel>

                    <CheckBox x:Name="chkAktif"
                              Content="Mahasiswa aktif"
                              IsChecked="True"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Status Makan"/>

                    <ComboBox x:Name="cmbStatusMakan"
                              Height="30"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Sudah Makan"/>
                        <ComboBoxItem Content="Belum Makan"/>

                    </ComboBox>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="Simpan"
                                Width="80"
                                Height="35"
                                Margin="0,0,10,0"
                                Click="BtnSimpan_Click"/>

                        <Button Content="Edit"
                                Width="80"
                                Height="35"
                                Margin="0,0,10,0"
                                Click="BtnEdit_Click"/>

                        <Button Content="Reset"
                                Width="80"
                                Height="35"
                                Margin="0,0,10,0"
                                Click="BtnReset_Click"/>

                        <Button Content="Hapus"
                                Width="80"
                                Height="35"
                                Click="BtnHapus_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- DATA MAHASISWA -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="DATA MAHASISWA"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Cari berdasarkan NIM atau Nama"/>

                    <TextBox x:Name="txtCari"
                             Height="30"
                             Margin="0,5,0,10"
                             TextChanged="TxtCari_TextChanged"/>

                    <ListBox x:Name="lstMahasiswa"
                             Height="330"
                             BorderBrush="#D1D5DB"
                             BorderThickness="1"/>

                    <TextBlock x:Name="txtJumlah"
                               Text="Jumlah Mahasiswa: 0"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,12,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>